---
import "@fontsource-variable/inter"

interface Props {
  title: string
  /** Nav section id highlighted in the header; "" leaves nothing highlighted. */
  active?: string
  /** Pagefind section filter value for this page (e.g. "providers", "guides"). */
  section?: string
  /** Markdown pages deliver their frontmatter under this prop instead. */
  frontmatter?: { title?: string; active?: string; section?: string }
}

const { title, active = "", section } = Astro.props.frontmatter ?? Astro.props
const base = import.meta.env.BASE_URL
// RFC 8288 web linking is served via <link> here; GitHub Pages cannot set
// custom response headers, so the head-link form carries the same pointers.
const ORIGIN = "https://gregnazario.github.io"

const nav = [
  { id: "models", label: "Models", href: `${base}models/` },
  { id: "free", label: "Free", href: `${base}free/` },
  { id: "providers", label: "Providers", href: `${base}providers/` },
  { id: "verify", label: "Verify", href: `${base}verify/` },
  { id: "help", label: "Help", href: `${base}help/` },
  { id: "download", label: "Download", href: `${base}download/` },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="api-catalog"
      type="application/linkset+json"
      href={`${ORIGIN}${base}.well-known/api-catalog`}
    />
    <link
      rel="catalog"
      type="application/json"
      href={`${ORIGIN}${base}.well-known/ai-catalog.json`}
    />
    <link
      rel="sitemap"
      type="application/xml"
      href={`${ORIGIN}${base}sitemap.xml`}
    />
  </head>
  <body>
    <header>
      <div class="container">
        <a class="site-name" href={`${base}models/`}>inference-providers</a>
        <nav>
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={active === item.id ? "active" : undefined}
                aria-current={active === item.id ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <form class="nav-search" action={`${base}search/`} method="get">
            <input
              type="search"
              name="q"
              placeholder="Search…"
              aria-label="Search"
            />
          </form>
        </nav>
      </div>
    </header>
    <main class="container" data-pagefind-body>
      {section && <div data-pagefind-filter={`section:${section}`}></div>}
      <slot />
    </main>
    <footer>
      <div class="container">
        <p>
          Every fact carries a source URL and verification date — see the
          repository.
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ---------- design tokens ---------- */
  :root {
    color-scheme: light dark;
    --bg: #fafafa;
    --fg: #111318;
    --muted: #5a6270;
    --border: #e4e7ec;
    --card: #ffffff;
    --accent: #6366f1;
    --accent-fg: #ffffff;
    /* Link text uses a darker indigo than --accent so body-size text keeps AA
       contrast in the light palette; --accent stays the pure brand tone for
       borders, pills, and focus rings. */
    --link: #4f46e5;
    --code-bg: #0d1117;
    --code-fg: #e6edf3;
    --chip-bg: #eef0f4;
    --shadow: 0 4px 16px rgb(17 19 24 / 0.08);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b0e14;
      --fg: #e6e9ef;
      --muted: #98a0ad;
      --border: #262c3a;
      --card: #11151e;
      --accent: #818cf8;
      --accent-fg: #0b0e14;
      --link: #818cf8;
      --chip-bg: rgb(230 233 239 / 0.08);
      --shadow: 0 4px 16px rgb(0 0 0 / 0.45);
    }
  }

  /* ---------- base ---------- */
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: "Inter Variable", ui-sans-serif, system-ui, sans-serif;
    line-height: 1.65;
    color: var(--fg);
    background: var(--bg);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 1.75rem 0 1rem;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 650;
    margin: 2.25rem 0 0.75rem;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 650;
    margin: 1.5rem 0 0.5rem;
  }

  a {
    color: var(--link);
  }

  .container {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ---------- header ---------- */
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .site-name {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--fg);
  }

  nav {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  nav a:hover {
    color: var(--fg);
    background: color-mix(in oklab, var(--fg) 8%, transparent);
  }

  nav a.active {
    color: var(--link);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }

  /* Header search: a plain GET form — Enter submits to the search page. */
  .nav-search input {
    font-family: inherit;
    font-size: 0.925rem;
    color: var(--fg);
    background: color-mix(in oklab, var(--fg) 5%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.28rem 0.8rem;
    width: 10rem;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .nav-search input::placeholder {
    color: var(--muted);
  }

  .nav-search input:hover {
    border-color: var(--accent);
  }

  /* ---------- chips ---------- */
  .chip {
    display: inline-block;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    font-size: 0.8rem;
    line-height: 1.45;
    white-space: nowrap;
    background: var(--chip-bg);
    color: var(--fg);
  }

  /* Reasoning styles. */
  .chip-budget,
  .chip-subscription {
    background: #fef3c7;
    color: #92400e;
  }

  .chip-effort,
  .chip-first_party {
    background: #e0e7ff;
    color: #3730a3;
  }

  .chip-toggle,
  .chip-aggregator {
    background: #ccfbf1;
    color: #115e59;
  }

  .chip-adaptive,
  .chip-preview {
    background: #ede9fe;
    color: #5b21b6;
  }

  .chip-always_on,
  .chip-deprecated,
  .chip-retired {
    background: #fee2e2;
    color: #991b1b;
  }

  .chip-none {
    background: var(--chip-bg);
    color: var(--muted);
  }

  /* Provider kinds and offering statuses. */
  .chip-cloud_hosted {
    background: #e0f2fe;
    color: #075985;
  }

  .chip-ga {
    background: #dcfce7;
    color: #166534;
  }

  @media (prefers-color-scheme: dark) {
    .chip-budget,
    .chip-subscription {
      background: rgb(245 158 11 / 0.16);
      color: #fcd34d;
    }

    .chip-effort,
    .chip-first_party {
      background: rgb(129 140 248 / 0.18);
      color: #c7d2fe;
    }

    .chip-toggle,
    .chip-aggregator {
      background: rgb(45 212 191 / 0.15);
      color: #5eead4;
    }

    .chip-adaptive,
    .chip-preview {
      background: rgb(167 139 250 / 0.16);
      color: #c4b5fd;
    }

    .chip-always_on,
    .chip-deprecated,
    .chip-retired {
      background: rgb(248 113 113 / 0.15);
      color: #fca5a5;
    }

    .chip-none {
      background: var(--chip-bg);
      color: var(--muted);
    }

    .chip-cloud_hosted {
      background: rgb(56 189 248 / 0.15);
      color: #7dd3fc;
    }

    .chip-ga {
      background: rgb(74 222 128 / 0.15);
      color: #86efac;
    }
  }

  /* ---------- tables ---------- */
  .table-wrap {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .table-wrap table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.925rem;
    margin: 0;
  }

  .table-wrap th,
  .table-wrap td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .table-wrap th {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .table-wrap thead th {
    background: color-mix(in oklab, var(--fg) 3%, transparent);
  }

  .table-wrap tbody tr:last-child th,
  .table-wrap tbody tr:last-child td {
    border-bottom: none;
  }

  .table-wrap tbody tr:hover {
    background: color-mix(in oklab, var(--fg) 4%, transparent);
  }

  /* Models tables whose provider popovers must escape the wrapper: the
     wrapper stops clipping (overflow-x scroll would cut the popovers off),
     and the rounded corners are held by radii on the corner th/td cells.
     Narrow screens keep the scrollable wrapper — the popover then becomes
     horizontally scrollable-to instead of clipped or breaking the page. */
  .table-wrap--open {
    overflow: visible;
  }

  @media (max-width: 50rem) {
    .table-wrap--open {
      overflow-x: auto;
    }
  }

  .table-wrap--open thead th:first-child {
    border-top-left-radius: 9px;
  }

  .table-wrap--open thead th:last-child {
    border-top-right-radius: 9px;
  }

  .table-wrap--open tbody tr:last-child td:first-child,
  .table-wrap--open tbody tr:last-child th:first-child {
    border-bottom-left-radius: 9px;
  }

  .table-wrap--open tbody tr:last-child td:last-child,
  .table-wrap--open tbody tr:last-child th:last-child {
    border-bottom-right-radius: 9px;
  }

  /* The hover wash paints through the cells so the rounded corners hold. */
  .table-wrap--open tbody tr:hover {
    background: none;
  }

  .table-wrap--open tbody tr:hover td {
    background: color-mix(in oklab, var(--fg) 4%, transparent);
  }

  /* ---------- table controls (injected by table-enhance.ts) ---------- */
  .table-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in oklab, var(--fg) 3%, transparent);
  }

  .table-controls input[type="search"],
  .table-controls select {
    font-family: inherit;
    font-size: 0.875rem;
    color: var(--fg);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
  }

  .table-controls input[type="search"] {
    min-width: 11rem;
  }

  .table-controls input[type="search"]::placeholder {
    color: var(--muted);
  }

  .table-controls input[type="search"]:hover,
  .table-controls select:hover {
    border-color: var(--accent);
  }

  .table-controls button {
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--link);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
  }

  .table-controls button:hover {
    background: color-mix(in oklab, var(--accent) 12%, transparent);
  }

  .table-controls .table-count {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  /* Sortable headers: the injected button keeps the th look; the arrow is
     the only added chrome, tinted with tokens when the sort is active. */
  .table-wrap th .sort-btn {
    font: inherit;
    color: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .table-wrap th .sort-btn:hover {
    color: var(--fg);
  }

  .table-wrap th .sort-btn::after {
    content: "↕";
    color: var(--muted);
    font-size: 0.7rem;
  }

  .table-wrap th.sort-asc .sort-btn::after {
    content: "↑";
    color: var(--link);
  }

  .table-wrap th.sort-desc .sort-btn::after {
    content: "↓";
    color: var(--link);
  }

  .table-wrap tbody tr.table-empty td {
    padding: 1rem 0.75rem;
    text-align: center;
    color: var(--muted);
  }

  .table-wrap--open tbody tr.table-empty:hover td {
    background: none;
  }

  /* ---------- code ---------- */
  code,
  pre,
  kbd,
  samp {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  pre {
    background: var(--code-bg);
    color: var(--code-fg);
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    font-size: 0.85rem;
    line-height: 1.55;
    overflow-x: auto;
  }

  pre code {
    color: inherit;
    background: none;
    padding: 0;
    font-size: inherit;
  }

  :not(pre) > code {
    background: color-mix(in oklab, var(--fg) 7%, transparent);
    border-radius: 5px;
    padding: 0.1em 0.35em;
    font-size: 0.875em;
  }

  /* ---------- collapsible example renderers ---------- */
  details {
    margin: 0.75rem 0;
  }

  details summary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  details summary::after {
    content: "+";
    color: var(--muted);
    font-weight: 600;
  }

  details[open] summary::after {
    content: "−";
  }

  details summary:hover {
    border-color: var(--accent);
  }

  details[open] summary {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }

  details pre {
    margin: 0.75rem 0 0.25rem;
  }

  /* ---------- providers popover (models tables) ---------- */
  .prov-pop {
    position: relative;
    display: inline-block;
  }

  /* Compact count chip; inherits the collapsible summary look above. */
  .prov-pop > summary {
    padding: 0.05rem 0.6rem;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .prov-pop > div {
    position: absolute;
    left: 0;
    top: calc(100% + 0.4rem);
    z-index: 30;
    /* 12rem keeps the popover inside the viewport when opened from the
       rightmost columns at the container width. */
    min-width: 12rem;
    max-width: 24rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 0.65rem 0.85rem;
  }

  .prov-item {
    margin: 0 0 0.45rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .prov-item:last-child {
    margin-bottom: 0;
  }

  .prov-times {
    margin-left: 0.4rem;
    font-size: 0.72rem;
    padding: 0.05rem 0.45rem;
  }

  .prov-wire {
    display: block;
    color: var(--muted);
    font-size: 0.78rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    overflow-wrap: anywhere;
  }

  .prov-none {
    color: var(--muted);
  }

  /* ---------- search ---------- */
  pagefind-search {
    display: block;
    margin-top: 1.5rem;
  }

  /* ---------- footer ---------- */
  footer {
    margin-top: 3.5rem;
    border-top: 1px solid var(--border);
    padding: 1.25rem 0 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
