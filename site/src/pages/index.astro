---
import { loadCatalog } from "@inference-providers/sdk"
import Base from "../layouts/Base.astro"

const c = loadCatalog()
const totalOfferings = c.providers.reduce((n, p) => n + p.offerings.length, 0)
const base = import.meta.env.BASE_URL
---

<Base title="inference-providers" active="">
  <h1>inference-providers</h1>
  <p>
    A provenance-tracked registry of AI model providers — auth, endpoints, and
    reasoning-parameter specs for every surface. All pages are generated from
    the emitted catalog; nothing here is hand-maintained.
  </p>
  <p class="stat-line">
    {c.models.length} models · {c.providers.length} providers · {totalOfferings} offerings
  </p>

  <h2>Providers</h2>
  <ul class="cards">
    {
      c.providers.map((p) => (
        <li>
          <a class="card" href={`${base}providers/${p.id}/`}>
            <span class="card-title">{p.name}</span>
            <span class={`chip chip-${p.kind}`}>{p.kind}</span>
            <span class="card-meta">auth: {p.auth[0]?.type ?? "none"}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p>
    Browse the <a href={`${base}models/`}>full model list</a> or
    <a href={`${base}download/`}>download the catalog</a>.
  </p>
</Base>

<style>
  /* Kept as one contiguous text line — it doubles as the site's stat marker. */
  .stat-line {
    margin: 1.25rem 0 1.5rem;
    padding: 0.9rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    font-weight: 650;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem;
    text-decoration: none;
    color: var(--fg);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow);
  }

  .card-title {
    font-weight: 600;
  }

  .card-meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
