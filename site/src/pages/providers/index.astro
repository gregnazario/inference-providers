---
import { loadCatalog } from "@inference-providers/sdk"
import Base from "../../layouts/Base.astro"

const c = loadCatalog()
const base = import.meta.env.BASE_URL
---

<Base title="Providers — inference-providers" active="providers" section="providers">
  <h1>Providers</h1>
  <p>
    {c.providers.length} providers, rendered from the emitted catalog. Open a
    provider for credentials setup, endpoints, plans, quirks, and models.
  </p>

  <div class="table-wrap" data-enhance>
    <table
      data-facets={JSON.stringify([
        { key: "kind", label: "Kind" },
        { key: "protocol", label: "Protocol" },
      ])}
    >
      <thead>
        <tr>
          <th data-sort-key="name" data-sort-type="text">Provider</th>
          <th data-sort-key="kind" data-sort-type="text">Kind</th>
          <th>Auth</th>
          <th>Protocols</th>
        </tr>
      </thead>
      <tbody>
        {
          c.providers.map((p) => (
            <tr
              data-facet-kind={p.kind}
              data-facet-protocol={[...new Set(p.endpoints.map((e) => e.protocol))].join(",")}
            >
              <td data-sort={p.name}>
                <a href={`${base}providers/${p.id}/`}>{p.name}</a>
              </td>
              <td data-sort={p.kind}>{p.kind}</td>
              <td>{p.auth.map((a) => `${a.id} (${a.type})`).join(", ")}</td>
              <td>{[...new Set(p.endpoints.map((e) => e.protocol))].join(", ")}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <script src="../../scripts/table-enhance.ts"></script>
</Base>
