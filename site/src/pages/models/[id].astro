---
import type { SdkCatalog } from "@inference-providers/sdk"
import { catalog } from "../../lib/catalog"
import Base from "../../layouts/Base.astro"
import CurlExample from "../../components/CurlExample.astro"
import ReasoningBadge from "../../components/ReasoningBadge.astro"
import { variantToken } from "../../lib/reasoningSummary"

type CatalogProvider = SdkCatalog["providers"][number]
type CatalogOffering = CatalogProvider["offerings"][number]
type CatalogEndpoint = CatalogProvider["endpoints"][number]
type Reasoning = CatalogOffering["reasoning"]

type ExampleInput = {
  provider: CatalogProvider
  offering: CatalogOffering
  endpoint: CatalogEndpoint
}

type OfferingRow = {
  providerId: string
  providerName: string
  wireId: string
  endpoint: string
  protocol: string
  status: string
  cost: CatalogOffering["cost"]
  limits: CatalogOffering["limits"]
  reasoning: Reasoning
  example: ExampleInput | null
}

/** Structural shapes of the reasoning control blocks (schema reasoning.ts). */
type EffortBlock = { param: string; values: string[]; default: string; notes?: string }
type BudgetBlock = {
  param: string
  min?: number
  max?: number
  zero_means_off: boolean
  special_values: Record<string, string>
  constraint?: string
}
type ToggleBlock = { param: string; on: string; off: string }

/** Static view model for one Reasoning-controls panel. */
type ControlsPanel = {
  providerId: string
  providerName: string
  wireId: string
  endpoint: string
  reasoning: Reasoning
  effort: EffortBlock | null
  budget: BudgetBlock | null
  toggle: ToggleBlock | null
}

export function getStaticPaths() {
  const c = catalog

  const offeringsByModel = new Map<string, { provider: CatalogProvider; offering: CatalogOffering }[]>()
  for (const p of c.providers) {
    for (const o of p.offerings) {
      const list = offeringsByModel.get(o.model) ?? []
      list.push({ provider: p, offering: o })
      offeringsByModel.set(o.model, list)
    }
  }

  return c.models.map((m) => ({
    params: { id: m.id.replace("/", "-") },
    props: {
      model: m,
      offerings: (offeringsByModel.get(m.id) ?? [])
        .map(({ provider, offering }): OfferingRow => {
          const endpoint = provider.endpoints.find((e) => e.id === offering.endpoint)
          return {
            providerId: provider.id,
            providerName: provider.name,
            wireId: offering.wire_id,
            endpoint: offering.endpoint,
            protocol: endpoint?.protocol ?? "—",
            status: offering.status,
            cost: offering.cost,
            limits: offering.limits ?? null,
            reasoning: offering.reasoning,
            example: endpoint ? { provider, offering, endpoint } : null,
          }
        })
        .sort(
          (a, b) =>
            a.providerId.localeCompare(b.providerId) || a.endpoint.localeCompare(b.endpoint),
        ),
    },
  }))
}

const { model, offerings } = Astro.props
const base = import.meta.env.BASE_URL

const examples = offerings
  .map((o) => o.example)
  .filter((e): e is ExampleInput => e !== null)

const openWeights =
  model.open_weights === undefined ? "—" : model.open_weights ? "yes" : "no"
const hfUrl = model.open_weights && model.hf_repo ? `https://huggingface.co/${model.hf_repo}` : null

const price = (cost: CatalogOffering["cost"]) => {
  if (!cost || (cost.input == null && cost.output == null)) return "—"
  const part = (v: number | null) => (v == null ? "—" : v.toFixed(2))
  return `${part(cost.input)} / ${part(cost.output)}`
}

/** Hero maxima: limits always visible even when the tables scroll. */
const maxContext = offerings.reduce((m, o) => Math.max(m, o.limits?.context ?? 0), 0)
const maxOutput = offerings.reduce((m, o) => Math.max(m, o.limits?.output ?? 0), 0)
const fmtLimit = (n: number) => (n > 0 ? n.toLocaleString("en-US") : "—")

const panels: ControlsPanel[] = offerings.map((o) => ({
  providerId: o.providerId,
  providerName: o.providerName,
  wireId: o.wireId,
  endpoint: o.endpoint,
  reasoning: o.reasoning,
  effort: "effort" in o.reasoning ? (o.reasoning.effort ?? null) : null,
  budget: "budget" in o.reasoning ? (o.reasoning.budget ?? null) : null,
  toggle: "toggle" in o.reasoning ? (o.reasoning.toggle ?? null) : null,
}))
---

<Base title={`${model.name} — inference-providers`} active="models" section="models">
  <h1>{model.name}</h1>
  <p>
    by {model.lab} · family {model.family}
  </p>

  <section>
    <h2>Facts</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          <tr>
            <th scope="row">Release date</th>
            <td>{model.release_date || "—"}</td>
          </tr>
          <tr>
            <th scope="row">Retired date</th>
            <td>{model.retired_date || "—"}</td>
          </tr>
          <tr>
            <th scope="row">Knowledge cutoff</th>
            <td>{model.knowledge_cutoff || "—"}</td>
          </tr>
          <tr>
            <th scope="row">Context (max)</th>
            <td>{fmtLimit(maxContext)}</td>
          </tr>
          <tr>
            <th scope="row">Max output</th>
            <td>{fmtLimit(maxOutput)}</td>
          </tr>
          <tr>
            <th scope="row">Modalities</th>
            <td>{model.modalities.input.join(", ")} → {model.modalities.output.join(", ")}</td>
          </tr>
          <tr>
            <th scope="row">Aliases</th>
            <td>
            {
              model.aliases.length > 0 ? (
                model.aliases.map((a) => <code>{a}</code>)
              ) : (
                "—"
              )
            }
          </td>
          </tr>
          <tr>
            <th scope="row">Open weights</th>
            <td>
            {openWeights}
            {hfUrl && (
              <>
                {" "}(<a href={hfUrl}>{model.hf_repo}</a>)
              </>
            )}
          </td>
          </tr>
          <tr>
            <th scope="row">Description</th>
            <td>{model.description}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="footnote">Unknown values are shown as —.</p>
  </section>

  {
    model.ranking && (
      <p class="ranking-line">
        <a href={model.ranking.url}>Intelligence Index v4.1.1: {model.ranking.aa_index}</a> ·{" "}
        {model.ranking.aa_variant} · Source: Artificial Analysis (accessed{" "}
        {model.ranking.verified})
      </p>
    )
  }

  <section>
    <h2>Offerings</h2>
    {
      offerings.length === 0 ? (
        <p>No provider offerings cataloged for this model.</p>
      ) : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Provider</th>
                <th>Wire ID</th>
                <th>Variant</th>
                <th>Endpoint</th>
                <th>Protocol</th>
                <th>Status</th>
                <th>Price (USD / Mtok)</th>
                <th>Reasoning</th>
              </tr>
            </thead>
            <tbody>
              {offerings.map((o) => (
                <tr>
                  <td>
                    <a href={`${base}providers/${o.providerId}/`}>{o.providerName}</a>
                  </td>
                  <td>
                    <code>{o.wireId}</code>
                  </td>
                  <td>
                    {
                      variantToken(o.wireId) && (
                        <span class="chip chip-variant">{variantToken(o.wireId)}</span>
                      )
                    }
                  </td>
                  <td>{o.endpoint}</td>
                  <td>{o.protocol}</td>
                  <td>
                    <span class={`chip chip-${o.status}`}>{o.status}</span>
                  </td>
                  <td class="num">{price(o.cost)}</td>
                  <td>
                    <ReasoningBadge reasoning={o.reasoning} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section>
    <h2>Reasoning controls</h2>
    {
      panels.length === 0 ? (
        <p>No provider offerings cataloged for this model.</p>
      ) : (
        panels.map((p) => (
          <div class="rc-panel">
            <p class="rc-head">
              <a href={`${base}providers/${p.providerId}/`}>{p.providerName}</a>
              <span class="muted">·</span> <code>{p.wireId}</code>
              <span class="muted">·</span> {p.endpoint}{" "}
              <span class={`chip chip-${p.reasoning.style}`}>{p.reasoning.style}</span>
            </p>

            {p.effort && (
              <p class="rc-line">
                <code>{p.effort.param}</code>{" "}
                <span class="pills">
                  {p.effort.values.map((v) => (
                    <span class={`pill${v === p.effort?.default ? " pill-default" : ""}`}>
                      {v}
                      {v === p.effort?.default && "●"}
                    </span>
                  ))}
                </span>
                {p.effort.notes && <span class="muted"> {p.effort.notes}</span>}
              </p>
            )}

            {p.budget && (
              <p class="rc-line">
                <code>{p.budget.param}</code>{" "}
                {p.budget.min !== undefined && p.budget.max !== undefined
                  ? `${p.budget.min.toLocaleString("en-US")}–${p.budget.max.toLocaleString("en-US")} tokens`
                  : p.budget.min !== undefined
                    ? `from ${p.budget.min.toLocaleString("en-US")} tokens`
                    : p.budget.max !== undefined
                      ? `up to ${p.budget.max.toLocaleString("en-US")} tokens`
                      : "range undocumented"}
                {p.budget.zero_means_off && " · 0 disables"}
                {p.budget.constraint && ` · ${p.budget.constraint}`}
                {Object.entries(p.budget.special_values).map(([k, v]) => (
                  <span class="muted">
                    {" "}
                    · {k} = {v}
                  </span>
                ))}
              </p>
            )}

            {p.toggle && (
              <p class="rc-line">
                <code>{p.toggle.param}</code> on <code>{p.toggle.on}</code> · off{" "}
                <code>{p.toggle.off}</code>
              </p>
            )}

            <p class="rc-line">
              <ReasoningBadge reasoning={p.reasoning} />
            </p>

            {p.reasoning.incompatible_with.length > 0 && (
              <p class="rc-line muted">Incompatible with: {p.reasoning.incompatible_with.join(", ")}</p>
            )}
          </div>
        ))
      )
    }
  </section>

  <section>
    <h2>Example requests</h2>
    {
      examples.length === 0 ? (
        <p>No example requests for this model.</p>
      ) : (
        examples.map((e) => (
          <CurlExample provider={e.provider} offering={e.offering} endpoint={e.endpoint} />
        ))
      )
    }
  </section>
</Base>

<style>
  .num {
    font-variant-numeric: tabular-nums;
  }

  .footnote {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .ranking-line {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
  }

  /* Variant chip: purely derived from the wire id, never a data field. */
  .chip-variant {
    background: var(--chip-bg);
    color: var(--muted);
    font-size: 0.72rem;
    padding: 0.05rem 0.45rem;
  }

  /* Reasoning-controls panels: static markup, one per offering. */
  .rc-panel {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    margin: 0.75rem 0;
  }

  .rc-head {
    margin: 0 0 0.4rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .rc-line {
    margin: 0.4rem 0;
    font-size: 0.9rem;
  }

  .pills {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .pill {
    display: inline-block;
    background: var(--chip-bg);
    border-radius: 999px;
    padding: 0.02rem 0.5rem;
    font-size: 0.78rem;
  }

  .pill-default {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
    color: var(--link);
    font-weight: 600;
  }

  .muted {
    color: var(--muted);
  }
</style>
