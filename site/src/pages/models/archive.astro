---
import { loadCatalog, type SdkCatalog } from "@inference-providers/sdk"
import Base from "../../layouts/Base.astro"
import { classify } from "../../lib/freshness"

type ModelAccumulator = { offerings: number; context: number; output: number }

const c = loadCatalog()
const base = import.meta.env.BASE_URL
const { current, archived } = classify(c.models)

const modelHref = (modelId: string) => `${base}models/${modelId.replace("/", "-")}/`

// One pass over the providers to count offerings and track limit maxima per model.
const byModel = new Map<string, ModelAccumulator>()
for (const p of c.providers) {
  for (const o of p.offerings) {
    const acc = byModel.get(o.model) ?? { offerings: 0, context: 0, output: 0 }
    acc.offerings += 1
    if (o.limits) {
      if (o.limits.context > acc.context) acc.context = o.limits.context
      if (o.limits.output != null && o.limits.output > acc.output) acc.output = o.limits.output
    }
    byModel.set(o.model, acc)
  }
}

const fmtLimit = (n: number) => (n > 0 ? n.toLocaleString("en-US") : "—")
const fmtWeights = (openWeights: SdkCatalog["models"][number]["open_weights"]) =>
  openWeights === undefined ? "—" : openWeights ? "yes" : "no"

const rows = archived
  .map((m) => ({ model: m, acc: byModel.get(m.id) ?? { offerings: 0, context: 0, output: 0 } }))
  .sort((a, b) => a.model.lab.localeCompare(b.model.lab) || a.model.name.localeCompare(b.model.name))
---

<Base title="Archived models — inference-providers" active="models">
  <h1>Archived models</h1>
  <p>
    Models released more than 12 months ago (or retired). Kept for reference —
    provider offerings remain in the full artifacts.
  </p>
  <p class="intro-count">
    {archived.length} archived · <a href={`${base}models/`}>{current.length} current models</a>
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Lab</th>
          <th>Family</th>
          <th>Released</th>
          <th>Retired</th>
          <th class="num">Context</th>
          <th class="num">Output</th>
          <th>Open weights</th>
          <th class="num">Offerings</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ model, acc }) => (
            <tr>
              <td>
                <a href={modelHref(model.id)}>{model.name}</a>
              </td>
              <td>{model.lab}</td>
              <td>{model.family}</td>
              <td>{model.release_date || "—"}</td>
              <td>{model.retired_date || "—"}</td>
              <td class="num">{fmtLimit(acc.context)}</td>
              <td class="num">{fmtLimit(acc.output)}</td>
              <td>{fmtWeights(model.open_weights)}</td>
              <td class="num">{acc.offerings}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="footnote">
    Unknown values are shown as —. Context and output limits are the maximum
    across the model's offerings that record limits.
  </p>
</Base>

<style>
  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .intro-count {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .footnote {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
