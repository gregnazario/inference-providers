---
import type { SdkCatalog } from "@inference-providers/sdk"
import { catalog as c } from "../../lib/catalog"
import Base from "../../layouts/Base.astro"
import ProvidersCell from "../../components/ProvidersCell.astro"
import { modelRows } from "../../lib/modelRows"
import { reasoningSummary } from "../../lib/reasoningSummary"

const base = import.meta.env.BASE_URL

const modelHref = (modelId: string) => `${base}models/${modelId.replace("/", "-")}/`

const fmtLimit = (n: number) => (n > 0 ? n.toLocaleString("en-US") : "—")
const fmtWeights = (openWeights: SdkCatalog["models"][number]["open_weights"]) =>
  openWeights === undefined ? "—" : openWeights ? "yes" : "no"

const rows = modelRows(c, c.models)

const totalOfferings = c.providers.reduce((n, p) => n + p.offerings.length, 0)
---

<Base title="Models — inference-providers" active="models" section="models">
  <h1>Models</h1>
  <p>
    {c.models.length} models, rendered from the emitted catalog. Open a model
    for its facts and every provider offering.
  </p>
  <p class="stat-line">
    {c.models.length} models · {c.providers.length} providers · {totalOfferings} offerings
  </p>

  <div class="table-wrap table-wrap--open" data-enhance>
    <table
      data-facets={JSON.stringify([
        { key: "lab", label: "Lab" },
        { key: "weights", label: "Weights" },
      ])}
    >
      <thead>
        <tr>
          <th data-sort-key="name" data-sort-type="text">Model</th>
          <th data-sort-key="lab" data-sort-type="text">Lab</th>
          <th>Family</th>
          <th data-sort-key="release" data-sort-type="date">Released</th>
          <th class="num" data-sort-key="aa" data-sort-type="num">AA Index</th>
          <th data-sort-key="reasoning" data-sort-type="text">Reasoning</th>
          <th class="num" data-sort-key="context" data-sort-type="num">Context</th>
          <th class="num" data-sort-key="output" data-sort-type="num">Output</th>
          <th>Open weights</th>
          <th data-sort-key="providers" data-sort-type="num">Providers</th>
          <th class="num" data-sort-key="offerings" data-sort-type="num">Offerings</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ model, ...acc }) => (
            <tr
              data-facet-lab={model.lab}
              data-facet-weights={
                model.open_weights === undefined
                  ? "unknown"
                  : model.open_weights
                    ? "open"
                    : "closed"
              }
            >
              <td data-sort={model.name}>
                <a href={modelHref(model.id)}>{model.name}</a>
              </td>
              <td data-sort={model.lab}>{model.lab}</td>
              <td>{model.family}</td>
              <td data-sort={model.release_date || ""}>{model.release_date || "—"}</td>
              <td class="num" data-sort={model.ranking ? String(model.ranking.aa_index) : ""}>
                {
                  model.ranking ? (
                    <>
                      <strong>{model.ranking.aa_index}</strong>
                      <sup class="aa-ver">v4.1.1</sup>
                    </>
                  ) : (
                    "—"
                  )
                }
              </td>
              <td data-sort={reasoningSummary(acc.reasonings)}>
                {reasoningSummary(acc.reasonings)}
              </td>
              <td class="num" data-sort={acc.context > 0 ? String(acc.context) : ""}>
                {fmtLimit(acc.context)}
              </td>
              <td class="num" data-sort={acc.output > 0 ? String(acc.output) : ""}>
                {fmtLimit(acc.output)}
              </td>
              <td
                data-sort={
                  model.open_weights === undefined
                    ? ""
                    : model.open_weights
                      ? "1"
                      : "0"
                }
              >
                {fmtWeights(model.open_weights)}
              </td>
              <td data-sort={String(acc.providers.length)}>
                <ProvidersCell base={base} providers={acc.providers} />
              </td>
              <td class="num" data-sort={String(acc.offerings)}>
                {acc.offerings}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <script src="../../scripts/table-enhance.ts"></script>

  <p class="footnote">
    Unknown values are shown as —. Context and output limits are the maximum
    across the model's offerings that record limits. The Providers count is
    unique providers — open it for each provider's wire IDs; ×N marks a
    provider serving the model on N endpoints. AA Index is the Artificial
    Analysis Intelligence Index for the model's most capable configuration —
    see the model page for the scored variant.
  </p>
  <p class="footnote">
    Intelligence Index v4.1.1 scores by{" "}
    <a href="https://artificialanalysis.ai">Artificial Analysis</a>, accessed
    2026-08-20 —{" "}
    <a href="https://artificialanalysis.ai/leaderboards/models">methodology</a>.
  </p>
</Base>

<style>
  /* Kept as one contiguous text line — it doubles as the site's stat marker
     (carried over from the former homepage). */
  .stat-line {
    margin: 0 0 1.5rem;
    padding: 0.6rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .aa-ver {
    color: var(--muted);
    font-size: 0.62rem;
    margin-left: 0.15rem;
  }

  .footnote {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
