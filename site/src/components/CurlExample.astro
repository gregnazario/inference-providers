---
import {
  computeExample,
  escapeHtml,
  type CatalogEndpoint,
  type CatalogOffering,
  type CatalogProvider,
} from "../lib/example"

interface Props {
  provider: CatalogProvider
  offering: CatalogOffering
  endpoint: CatalogEndpoint
}

const { provider, offering, endpoint } = Astro.props

const { url, headers, sigv4Fallback, body } = computeExample(provider, offering, endpoint)

const note = sigv4Fallback ? "sigv4 endpoints require request signing — see provider page" : null

const headerLines = Object.keys(headers).map((name) => `-H '${name}: ${headers[name]}'`)

const json = JSON.stringify(body, null, 2)
const command = [
  ...(note ? [`# ${note}`] : []),
  `curl '${url}' \\`,
  ...headerLines.map((line) => `  ${line} \\`),
  `  -d '${json}'`,
].join("\n")

const label = `${provider.name} · ${endpoint.protocol} · ${offering.wire_id}`

// Header/body payloads shared by every renderer. JSON.stringify output is a
// valid Python dict literal as well as a TS object literal, and insertion
// order (sorted headers) is preserved.
const headersJson = JSON.stringify(headers, null, 2)
const indent = (s: string, pad: string) => s.replace(/\n/g, `\n${pad}`)

const python = [
  "import requests",
  "",
  "resp = requests.post(",
  `    "${url}",`,
  `    headers=${indent(headersJson, "    ")},`,
  `    json=${indent(json, "    ")},`,
  ")",
  "print(resp.json())",
].join("\n")

const typescript = [
  `const resp = await fetch("${url}", {`,
  `  method: "POST",`,
  `  headers: ${indent(headersJson, "  ")},`,
  `  body: JSON.stringify(${indent(json, "  ")}),`,
  `})`,
  "console.log(await resp.json())",
].join("\n")

const commandHtml = escapeHtml(command)
const pythonHtml = escapeHtml(python)
const typescriptHtml = escapeHtml(typescript)

// Rendered as one raw fragment so the emitted markup stays the plain
// <details><summary>…</summary><pre><code>…</code></pre></details> shape
// (no scoped attributes are needed — nothing in <style> targets these).
const renderersHtml = [
  `<details><summary>Python (requests)</summary><pre><code>${pythonHtml}</code></pre></details>`,
  `<details><summary>TypeScript (fetch)</summary><pre><code>${typescriptHtml}</code></pre></details>`,
].join("\n")
---

<div class="curl-example">
  <p class="label">{label}</p>
  <pre><code set:html={commandHtml} /></pre>
  <Fragment set:html={renderersHtml} />
</div>

<style>
  .curl-example {
    margin: 0 0 1.5rem;
  }

  .label {
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
</style>
