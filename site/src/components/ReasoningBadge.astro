---
interface ReasoningLike {
  style: string
  default: string
  mandatory: boolean
  returns: string
  must_round_trip: string
}

interface Props {
  reasoning: ReasoningLike
}

const { reasoning } = Astro.props
const parts = [`${reasoning.style} · default ${reasoning.default}`]
if (reasoning.mandatory) parts.push("mandatory")
parts.push(`returns ${reasoning.returns}`)
if (reasoning.must_round_trip !== "") parts.push(`round-trips ${reasoning.must_round_trip}`)
---

<span class={`chip chip-${reasoning.style}`}>{parts.join(" · ")}</span>
